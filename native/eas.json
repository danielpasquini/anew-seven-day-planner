{
  "cli": { "version": ">=16.0.0", "appVersionSource": "local" },
  "build": {
    "development": { "developmentClient": true, "distribution": "internal", "env": { "EXPO_PUBLIC_ENABLE_DEMO": "true" } },
    "preview": { "distribution": "internal", "android": { "buildType": "apk" }, "env": { "EXPO_PUBLIC_ENABLE_DEMO": "true" } },
    "production": { "autoIncrement": true, "env": { "EXPO_PUBLIC_ENABLE_DEMO": "false" } }
  }
}
