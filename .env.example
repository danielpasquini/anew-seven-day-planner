# Server only. Never use NEXT_PUBLIC_ for a provider credential.
GEMINI_API_KEY=
# Verified with the live server adapter on 2026-10-13; use npm run check:ai to check access.
GEMINI_MODEL=gemini-3.1-flash-lite
GEMINI_TIMEOUT_MS=45000
AI_ENABLED=false
# Enable only after evaluating the project's billing status, provider terms and data handling.
# Authenticated accounts share a six-request/minute backstop per server process.

# Firebase browser identifiers are public configuration, not server/admin credentials.
# Add the actual values from your own Firebase project and deploy the repository rules.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
# Enable only after configuring the Google sign-in provider and authorized domains.
NEXT_PUBLIC_ENABLE_GOOGLE_AUTH=false

# HTTPS origin of the deployed Next backend for native builds; blank retains relative URLs on web only.
NEXT_PUBLIC_API_BASE_URL=
# Optional exact additional web origins, comma-separated. Wildcards are ignored.
# Native origins capacitor://localhost and https://localhost are explicitly supported.
AI_ALLOWED_ORIGINS=

# Local testing only: exposes an isolated in-memory demo, never Firebase or Gemini access.
# Keep false in release/store builds.
NEXT_PUBLIC_ENABLE_DEMO=false
