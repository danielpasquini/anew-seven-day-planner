rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isOwner(userId) {
      return request.auth != null && request.auth.uid == userId;
    }
    function isCurrentLegalAcceptance() {
      let data = request.resource.data;
      return data.keys().hasAll([
          'usageTermsVersion', 'privacyVersion', 'healthVersion',
          'adultConfirmed', 'acceptedAt'
        ])
        && data.keys().hasOnly([
          'usageTermsVersion', 'privacyVersion', 'healthVersion',
          'adultConfirmed', 'acceptedAt'
        ])
        && data.usageTermsVersion == '2026-10-12-mobile-1'
        && data.privacyVersion == '2026-10-12-mobile-1'
        && data.healthVersion == '2026-10-12-mobile-1'
        && data.adultConfirmed == true
        && data.acceptedAt is timestamp
        && data.acceptedAt == request.time;
    }
    // Registration records confirmations before email verification.
    // Protected server features also require verified email and this record.
    match /users/{userId}/settings/legal {
      allow get: if isOwner(userId);
      allow create, update: if isOwner(userId) && isCurrentLegalAcceptance();
      // Removing confirmations must immediately disable protected features.
      allow delete: if isOwner(userId);
    }
    // Journals, guides and preferences remain local in this version.
    // Do not add recursive owner-write rules without a defined cloud schema.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
